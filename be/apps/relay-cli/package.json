{
  "name": "@starci/next-relay",
  "version": "0.1.0",
  "description": "StarCi Relay: the command line a learner installs once (npm i -g @starci/next-relay) so StarCi labs and scenarios run on their own machine.",
  "keywords": [
    "starci",
    "relay",
    "cli"
  ],
  "license": "UNLICENSED",
  "bin": {
    "starci-relay": "dist/bundle/starci-relay.cjs"
  },
  "files": [
    "dist/bundle",
    "README.md"
  ],
  "scripts": {
    "prepack": "node bundle.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@starci/common": "1.0.1",
    "@starci/nest-kit": "0.2.2",
    "esbuild": "0.28.2",
    "nest-commander": "3.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "smol-toml": "1.9.0",
    "socket.io-client": "4.8.3",
    "tslib": "2.9.1",
    "undici": "6.29.1",
    "yaml": "2.9.1"
  }
}
