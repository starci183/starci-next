{
  "providers": [
    {
      "id": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "maxConcurrency": 8,
      "keys": [{ "alias": "openrouter-primary", "env": "OPENROUTER_API_KEY", "maxConcurrency": 8 }],
      "models": [
        { "id": "deepseek/deepseek-v4.1-flash", "contextWindow": 1048576 },
        { "id": "deepseek/deepseek-v4-pro", "contextWindow": 1048576 }
      ]
    }
  ],
  "defaults": { "maxAttempts": 4, "timeoutMs": 30000, "deadlineMs": 60000 },
  "profiles": {
    "lesson": {
      "model": "deepseek/deepseek-v4.1-flash",
      "fallbacks": ["deepseek/deepseek-v4-pro"],
      "allowFallback": true,
      "maxAttempts": 4,
      "timeoutMs": 30000,
      "deadlineMs": 60000
    }
  },
  "resilience": { "keyBreaker": { "failureThreshold": 3 }, "providerBreaker": { "failureThreshold": 8 } },
  "telemetry": { "includeContent": false },
  "limits": { "maxOutputTokens": 1024, "reservedPromptTokens": 2048 }
}
