{
  "hfs": 3,
  "kind": "app",
  "project": "starci-next",
  "sides": {
    "be": {
      "apps": [
        {
          "name": "core",
          "kind": "api"
        },
        {
          "name": "relay",
          "kind": "api"
        },
        {
          "name": "cli",
          "kind": "cli"
        }
      ],
      "kinds": ["api", "cli", "jobs", "webhooks"],
      "connections": [
        {
          "name": "primary",
          "envPrefix": "PRIMARY_DB",
          "owner": "core",
          "isolation": "database"
        }
      ],
      "patterns": ["fenced-job", "queue", "webhooks", "realtime"],
      "optionalSlots": ["be.contract.graphql"],
      "backing": ["redis"]
    },
    "fe": {
      "apps": [
        {
          "name": "landing",
          "kind": "next"
        },
        {
          "name": "app",
          "kind": "next"
        }
      ],
      "grammar": "core",
      "reads": ["be/contracts/"],
      "optionalSlots": ["fe.package.ui", "fe.package.i18n", "repo.i18n-dynamic-keys"]
    }
  }
}
