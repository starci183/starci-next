{
  "hfs": 3,
  "kind": "app",
  "project": "starci-next",
  "sides": {
    "be": {
      "apps": [
        {
          "name": "core",
          "kind": "api"
        },
        {
          "name": "cli",
          "kind": "cli"
        },
        {
          "name": "relay-cli",
          "kind": "client-cli",
          "package": "@starci/next",
          "bin": "starci-next"
        }
      ],
      "kinds": ["api", "cli", "client-cli", "realtime", "webhooks"],
      "connections": [
        {
          "name": "primary",
          "envPrefix": "PRIMARY_DB",
          "owner": "core",
          "isolation": "database"
        }
      ],
      "patterns": ["webhooks", "realtime"],
      "optionalSlots": ["be.contract.graphql"]
    },
    "fe": {
      "apps": [
        {
          "name": "landing",
          "kind": "next"
        },
        {
          "name": "app",
          "kind": "next"
        }
      ],
      "grammar": "core",
      "reads": ["be/contracts/"],
      "optionalSlots": ["fe.package.ui", "fe.package.i18n", "repo.i18n-dynamic-keys"]
    }
  }
}
