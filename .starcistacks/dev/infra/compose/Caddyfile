{
    admin 127.0.0.1:2019
    auto_https off
}

# The dev entry origin: /graphql (the learner device uploads included), the MCP endpoint (/mcp) and the learner device socket (/socket.io/*, WebSocket upgrade passed
# through) go to the core api, everything else to the Next app; /api/* stays routed to the core for the webhooks and the learner CLI. The auth doors (/auth/*) are called
# on the core api origin directly by the browser (NEXT_PUBLIC_API_URL / NEXT_PUBLIC_LOCAL_API_URL), not through this entry. Plain http on localhost (a secure context for Chrome).
# The container listens on 3080; the host port and the two upstream ports come from environments.dev.local.ports (compose.yaml).
:3080 {
    @core path /api/* /graphql /mcp /socket.io/*
    handle @core {
        reverse_proxy host.docker.internal:{$CORE_PORT}
    }
    handle {
        reverse_proxy host.docker.internal:{$APP_PORT}
    }
}
