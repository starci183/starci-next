{
    admin 127.0.0.1:2019
    auto_https off
}

# The dev entry origin, the same routing as the production app host: the identity doors (/api/*), GraphQL (/graphql, the learner device
# uploads included) and the learner device socket (/socket.io/*, WebSocket upgrade passed through) go to the core api,
# everything else to the Next app, so the host-only session cookie reaches the doors. Plain http on localhost (a secure context for Chrome).
:3080 {
    @core path /api/* /graphql /socket.io/*
    handle @core {
        reverse_proxy host.docker.internal:3001
    }
    handle {
        reverse_proxy host.docker.internal:3000
    }
}
