{
  "realm": "starci-next-identity",
  "displayName": "StarCi Next (development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": false,
  "passwordPolicy": "length(8)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 5184000,
  "eventsEnabled": true,
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "TEACHER",
        "description": "Thầy: signs every experience item and appoints reviewers."
      },
      {
        "name": "REVIEWER",
        "description": "Reviewer appointed by the teacher: signs the experience items of the appointed parts."
      }
    ]
  },
  "clients": [
    {
      "clientId": "starci-next-identity",
      "name": "StarCi Next identity (development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://next.starci.org/sign-in/callback"
      ],
      "webOrigins": [
        "https://next.starci.org"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://next.starci.org/sign-in/callback"
      },
      "protocolMappers": [
        {
          "name": "audience-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "starci-next-identity",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-starci-next-identity",
      "enabled": true,
      "serviceAccountClientId": "starci-next-identity",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}
