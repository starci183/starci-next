{
    admin 127.0.0.1:2019
}

# The app host is one origin for the browser: the identity doors (/api/*), GraphQL (/graphql, the learner device uploads included) and
# the learner device socket (/socket.io/*, WebSocket upgrade passed through) go to the core api, so the host-only session cookie
# reaches them; every other path is the Next app. The api. host stays for the payment webhooks (SePay, payOS IPN).
starci-next.example.invalid {
    @core path /api/* /graphql /socket.io/*
    handle @core {
        reverse_proxy core:3001
    }
    handle {
        reverse_proxy app:3000
    }
}

api.starci-next.example.invalid {
    reverse_proxy core:3001
}

www.starci-next.example.invalid {
    reverse_proxy landing:3002
}
