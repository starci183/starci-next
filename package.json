{
  "name": "starci-next",
  "version": "0.0.9",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*"
  ],
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.5",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.5",
    "@socket.io/postgres-adapter": "0.5.0",
    "@starci/ai-router": "0.10.1",
    "@starci/auth": "0.7.2",
    "@starci/common": "1.0.1",
    "@starci/mail": "0.3.0",
    "@starci/nest-kit": "0.2.2",
    "@starci/object-storage": "0.3.1",
    "@starci/seed": "0.3.0",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.14.2",
    "ioredis": "5.11.1",
    "nest-commander": "3.21.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "smol-toml": "1.9.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tslib": "2.9.1",
    "typeorm": "0.3.31",
    "undici": "6.29.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "3.28.4",
    "@starci/eslint-canon-fe": "9.22.0",
    "@starci/eslint-grammar-core": "0.55.0",
    "@starci/jest-preset": "2.12.0",
    "@starci/prettier-config": "1.1.0",
    "@starci/stylelint-canon": "2.9.9",
    "@starci/test-world": "2.2.1",
    "@starci/tsconfig": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "starci-harness": "1.1.0-alpha.194",
    "stylelint": "17.15.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tslib": "2.9.1",
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "@graphql-tools/utils": "12.1.0",
    "@xyflow/react": "12.11.6",
    "dayjs": "1.11.21",
    "zod": "4.6.7",
    "zustand": "5.0.12",
    "@starci/hfs": "6.17.8",
    "@starci/common": "1.0.1",
    "mermaid": "11.17.2",
    "katex": "0.18.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be": "cd be && ts-node-dev --respawn --transpile-only --debounce 1000 --watch src,apps -r tsconfig-paths/register apps/core/src/main.ts",
    "dev:fe:landing": "npm run codegen --silent && turbo run dev --filter=@starci-next/landing",
    "dev:fe:app": "npm run codegen --silent && turbo run dev --filter=@starci-next/app",
    "start:core": "node be/dist/apps/core/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "build:relay-cli": "cd be && tsc -p apps/relay-cli/tsconfig.build.json && tsc-alias -p apps/relay-cli/tsconfig.build.json",
    "start:landing": "npm run start -w @starci-next/landing",
    "start:app": "npm run start -w @starci-next/app",
    "docker:build": "npm run docker:build:core && npm run docker:build:cli && npm run docker:build:landing && npm run docker:build:app",
    "docker:build:core": "docker build -f be/apps/core/Dockerfile -t starci-next/core:dev .",
    "docker:build:cli": "docker build -f be/apps/cli/Dockerfile -t starci-next/cli:dev .",
    "docker:build:landing": "docker build -f fe/apps/landing/Dockerfile -t starci-next/landing:dev .",
    "docker:build:app": "docker build -f fe/apps/app/Dockerfile -t starci-next/app:dev .",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "codegen:graphql": "node scripts/codegen.mjs --graphql",
    "typecheck": "npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "npm run codegen --silent && turbo run build --filter=./fe/packages/* && starci app check --gate lint",
    "lint:fix": "npm run codegen --silent && turbo run build --filter=./fe/packages/* && starci app check --gate lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "test": "cd be && jest --selectProjects unit --coverage",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && cd be && jest --selectProjects e2e",
    "db:image": "docker build --tag starci-next-db:local .starcistacks/images/db",
    "db:create": "npm run db:image && docker create --name starci-next-dev-db -p 127.0.0.1:54322:5432 -e POSTGRES_HOST_AUTH_METHOD=trust -v starci-next-dev-db-data:/var/lib/postgresql/data starci-next-db:local",
    "db:start": "docker start starci-next-dev-db",
    "db:stop": "docker stop starci-next-dev-db",
    "db:reset": "docker rm -f starci-next-dev-db && docker volume rm starci-next-dev-db-data && npm run db:create && npm run db:start",
    "db:new": "starci app db new",
    "db:push": "starci app db migrate --db-url-env DATABASE_URL --execute",
    "db:plan": "starci app db migrate --db-url-env DATABASE_URL",
    "db:dump": "starci app db dump --db-url-env DATABASE_URL --out ../starci-next-db-backups",
    "db:lint": "starci app check --gate db",
    "redis:create": "docker create --name starci-next-dev-redis -p 127.0.0.1:6379:6379 -v starci-next-dev-redis-data:/data redis:7@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f redis-server --appendonly yes",
    "redis:start": "docker start starci-next-dev-redis",
    "redis:stop": "docker stop starci-next-dev-redis",
    "contract:emit": "starci app emit"
  }
}
