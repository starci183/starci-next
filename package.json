{
  "name": "starci-next",
  "version": "0.0.2",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*",
    "packages/*"
  ],
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.5",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.5",
    "@socket.io/postgres-adapter": "0.5.0",
    "@starci/ai-router": "0.6.0",
    "@starci/auth-oidc": "0.2.0",
    "@starci/common": "1.0.0",
    "@starci/mail": "0.2.0",
    "@starci/nest-kit": "0.2.2",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.14.2",
    "ioredis": "5.11.1",
    "nest-commander": "3.21.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tslib": "2.8.1",
    "typeorm": "0.3.31",
    "undici": "6.29.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "3.20.0",
    "@starci/eslint-canon-fe": "9.16.8",
    "@starci/eslint-grammar-core": "0.26.0",
    "@starci/jest-preset": "2.9.0",
    "@starci/prettier-config": "1.1.0",
    "@starci/stylelint-canon": "2.7.1",
    "@starci/test-world": "1.4.0",
    "@starci/tsconfig": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "starci-harness": "1.1.0-alpha.99",
    "stylelint": "17.15.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "@graphql-tools/utils": "12.1.0",
    "@xyflow/react": "12.11.6",
    "dayjs": "1.11.21",
    "zod": "4.6.7",
    "zustand": "5.0.12",
    "@starci/hfs": "6.3.0",
    "@starci/common": "1.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be:core": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/core/src/main.ts",
    "dev:be:relay": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/relay/src/main.ts",
    "dev:fe:landing": "npm run codegen --silent && turbo run dev --filter=@starci-next/landing",
    "dev:fe:app": "npm run codegen --silent && turbo run dev --filter=@starci-next/app",
    "start:core": "node be/dist/apps/core/src/main.js",
    "start:relay": "node be/dist/apps/relay/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "migrate": "node be/dist/apps/cli/src/main.js migrate run",
    "start:landing": "npm run start -w @starci-next/landing",
    "start:app": "npm run start -w @starci-next/app",
    "build:modules": "turbo run build --filter=./packages/*",
    "docker:build": "npm run docker:build:core && npm run docker:build:relay && npm run docker:build:cli && npm run docker:build:landing && npm run docker:build:app",
    "docker:build:core": "docker build -f be/apps/core/Dockerfile -t starci-next/core:dev .",
    "docker:build:relay": "docker build -f be/apps/relay/Dockerfile -t starci-next/relay:dev .",
    "docker:build:cli": "docker build -f be/apps/cli/Dockerfile -t starci-next/cli:dev .",
    "docker:build:landing": "docker build -f fe/apps/landing/Dockerfile -t starci-next/landing:dev .",
    "docker:build:app": "docker build -f fe/apps/app/Dockerfile -t starci-next/app:dev .",
    "build:be": "npm run build:modules --silent && cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run build:modules --silent && npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "codegen:graphql": "node scripts/codegen.mjs --graphql",
    "typecheck": "npm run build:modules --silent && npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "npm run build:modules --silent && npm run codegen --silent && turbo run build --filter=./fe/packages/* && starci app check --gate lint",
    "lint:fix": "npm run build:modules --silent && npm run codegen --silent && turbo run build --filter=./fe/packages/* && starci app check --gate lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "test": "npm run build:modules --silent && cd be && jest --selectProjects unit --coverage",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && cd be && jest --selectProjects e2e",
    "test:contract": "npm run typecheck:tests && cd be && jest --selectProjects contract",
    "test:world": "starci app world up",
    "contract:emit": "starci app emit"
  }
}
